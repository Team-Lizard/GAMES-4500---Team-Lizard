/* Main menu styling */
#MenuContainer {
    flex-grow: 1;
    background-color: rgba(0, 0, 32, 0.8);
}

#MenuSelector {
    display: flex;
    flex-direction: row;
    height: 10%;
    flex-wrap: nowrap;
    margin: 10px;
}

.MenuSelectorButton {
    flex-grow: 1;
    height: auto;
    min-height: 20px;
}

#SubmenuScrollView {
    height: 90%;
}

.unity-button:focus {
    background-color: rgb(194, 255, 205);
}
.option-toggle > .unity-toggle__input:focus {
    background-color: rgb(194, 255, 205);
}


/* Reusable submenu row styling */
.debug-binding,
.input-binding {
    display: flex;
    flex-direction: row;
    height: auto;
    min-height: 20px;
    margin-left: 5px;
    margin-right: 5px;
    flex-grow: 1;
}

.binding-input,
.rebind-button {
    -unity-text-align: middle-center;
    flex-grow: 1;
    min-width: 200px;
}

.binding-label {
    -unity-text-align: upper-center;
    color: white;
    flex-grow: 1;
    min-width: 200px;
}
